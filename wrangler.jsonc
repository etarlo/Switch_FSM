{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "switchfsm",
  "main": "_worker.js",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
